# Google OAuth 2.0 Configuration
# To use Google Login, create a copy of this file named '.env'
# and fill in your Client ID and Client Secret from Google Cloud Console.

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Configuration
# Optional: Provide a secure 256-bit base64-encoded secret key for JWT signing.
# If omitted, the application will use a default key for local development.
JWT_SECRET=default_local_jwt_secret_key_which_must_be_at_least_256_bits_long
